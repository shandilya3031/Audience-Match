# Copy this file to .env and fill in real values. Never commit .env.
APP_ENV=dev

# Bedrock / AWS
AWS_REGION=us-east-1
BEDROCK_SONNET_MODEL_ID=anthropic.claude-sonnet-4-5
BEDROCK_HAIKU_MODEL_ID=anthropic.claude-haiku-4-5
BEDROCK_FALLBACK_MODEL_ID=meta.llama4-maverick

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment-here
PINECONE_INDEX_NAME=audience-match

# PostgreSQL
POSTGRES_DSN=postgresql://app_user:password@localhost:5432/audience_match
POSTGRES_READONLY_DSN=postgresql://app_readonly:password@localhost:5432/audience_match

# DynamoDB
DYNAMODB_CHAT_HISTORY_TABLE=ChatHistory
DYNAMODB_SCHEMA_METADATA_TABLE=SchemaMetadata
DYNAMODB_PROMPT_REGISTRY_TABLE=PromptRegistry

# S3
S3_RAW_DOCUMENTS_BUCKET=your-raw-documents-bucket-here
S3_RAW_CUSTOMER_DATA_BUCKET=your-raw-customer-data-bucket-here

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=audience-match-dev
