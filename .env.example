# Copy this file to .env and fill in real values. Never commit .env.
APP_ENV=dev

# Groq (LLM inference) -- free-tier hosted API for open-weight models, no
# approval wait. Get a key at https://console.groq.com (Sign up -> API Keys).
# Model IDs below were current as of Sept 2026; Groq's catalog changes fairly
# often (e.g. llama-3.3-70b-versatile/llama-3.1-8b-instant were deprecated on
# 2026-06-17) -- if invoke calls start failing with an invalid-model error,
# re-check https://console.groq.com/docs/models before assuming anything else
# is broken.
GROQ_API_KEY=your-groq-api-key-here
GROQ_SONNET_MODEL_ID=openai/gpt-oss-120b
GROQ_HAIKU_MODEL_ID=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL_ID=qwen/qwen3.6-27b

# Chroma (local vector store) -- embedded, no server/account needed. The
# embedding model itself runs locally via sentence-transformers (also free).
CHROMA_PERSIST_DIRECTORY=./data/chroma
EMBEDDING_MODEL_NAME=sentence-transformers/all-mpnet-base-v2

# PostgreSQL (run locally, e.g. via Docker: postgres:16). POSTGRES_READONLY_PASSWORD
# must match the password baked into POSTGRES_READONLY_DSN below -- it's what
# scripts/apply_schema.py uses to create the app_readonly role.
POSTGRES_DSN=postgresql://app_user:password@localhost:5432/audience_match
POSTGRES_READONLY_DSN=postgresql://app_readonly:readonly_password@localhost:5432/audience_match
POSTGRES_READONLY_PASSWORD=readonly_password

# Local filesystem (folded in from S3 -- no cloud account needed)
RAW_DOCUMENTS_DIR=./data/raw_documents
RAW_CUSTOMER_DATA_DIR=./data/raw_customer_data

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=audience-match-dev
# LANGSMITH_WORKSPACE_ID=your-workspace-id-here  # optional, for org-scoped keys
